rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isProvider(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.roles is list
        && get(/databases/$(database)/documents/users/$(uid)).data.roles.hasAny(['provider']);
    }

    function providerCanReadAlert(alertId, uid) {
      let alert = get(/databases/$(database)/documents/emergencyAlerts/$(alertId)).data;
      let notification = get(/databases/$(database)/documents/providerNotifications/$(alertId + "_" + uid)).data;
      return exists(/databases/$(database)/documents/providerNotifications/$(alertId + "_" + uid))
        && notification.providerId == uid
        && (
          (notification.status == 'ACTIVE'
            && alert.status == 'ACTIVE'
            && alert.expiresAt > request.time)
          || (notification.status == 'ACCEPTED'
            && alert.status == 'ACCEPTED'
            && alert.acceptedProviderId == uid)
        );
    }

    function activeProviderNotification(alertId, uid) {
      return exists(/databases/$(database)/documents/providerNotifications/$(alertId + "_" + uid))
        && get(/databases/$(database)/documents/providerNotifications/$(alertId + "_" + uid)).data.providerId == uid
        && get(/databases/$(database)/documents/providerNotifications/$(alertId + "_" + uid)).data.status == 'ACTIVE';
    }

    match /users/{uid} {
      function validProviderRatingUpdate() {
        let jobId = request.resource.data.lastRatingJobId;
        let jobPath = /databases/$(database)/documents/jobPosts/$(jobId);
        return signedIn()
          && jobId is string
          && get(jobPath).data.customerId == request.auth.uid
          && get(jobPath).data.assignedProviderId == uid
          && get(jobPath).data.customerConfirmed == false
          && getAfter(jobPath).data.customerConfirmed == true
          && getAfter(jobPath).data.status == 'Completed'
          && getAfter(jobPath).data.rating is int
          && getAfter(jobPath).data.rating >= 1
          && getAfter(jobPath).data.rating <= 5
          && getAfter(jobPath).data.diff(get(jobPath).data).affectedKeys()
            .hasOnly(['customerConfirmed', 'rating', 'reviewComment'])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ratingSum', 'ratingCount', 'lastRatingJobId'])
          && request.resource.data.ratingSum == resource.data.ratingSum + getAfter(jobPath).data.rating
          && request.resource.data.ratingCount == resource.data.ratingCount + 1;
      }

      allow create: if isOwner(uid)
        && request.resource.data.uid == uid;
      allow read: if isOwner(uid);
      allow update: if (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.roles == resource.data.roles
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ratingSum', 'ratingCount', 'lastRatingJobId', 'isVerified'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['emergencyAvailable', 'lastLocation', 'lastLocationAt'])
            || (
              isProvider(uid)
              && (
                (request.resource.data.emergencyAvailable == true
                  && request.resource.data.lastLocation is latlng
                  && request.resource.data.lastLocationAt == request.time)
                || (request.resource.data.emergencyAvailable == false
                  && !request.resource.data.keys().hasAny(['lastLocation', 'lastLocationAt']))
              )
            )
          )
        ) || validProviderRatingUpdate();
      allow delete: if false;
    }

    match /emergencyProviderProfiles/{providerId} {
      allow read: if signedIn()
        && resource.data.keys().hasOnly([
          'providerId', 'displayName', 'profilePhotoUrl', 'serviceCategories',
          'rating', 'ratingCount', 'isVerified', 'emergencyAvailable',
          'latitude', 'longitude', 'lastLocationAt'
        ])
        && resource.data.providerId == providerId
        && resource.data.emergencyAvailable == true
        && resource.data.latitude is number
        && resource.data.latitude >= -90
        && resource.data.latitude <= 90
        && resource.data.longitude is number
        && resource.data.longitude >= -180
        && resource.data.longitude <= 180
        && resource.data.lastLocationAt is timestamp;
      allow create, update, delete: if false;
    }

    match /emergencyCustomerState/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['activeAlertId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.activeAlertId)).data.customerId == uid
        && getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.activeAlertId)).data.status == 'ACTIVE';
      allow delete: if false;
    }

    match /emergencyAlerts/{alertId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.alertId == alertId
        && request.resource.data.keys().hasAll([
          'customerName', 'customerPhone', 'category', 'note', 'location',
          'status', 'createdAt', 'expiresAt', 'selectedProviderId',
          'acceptedProviderId', 'acceptedProviderName', 'acceptedProviderPhone', 'acceptedAt'
        ])
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'm')
        && request.resource.data.location is latlng
        && request.resource.data.customerName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.customerPhone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber
        && request.resource.data.acceptedProviderId == null
        && request.resource.data.acceptedProviderName == null
        && request.resource.data.acceptedProviderPhone == null
        && request.resource.data.acceptedAt == null
        && getAfter(/databases/$(database)/documents/emergencyCustomerState/$(request.auth.uid)).data.activeAlertId == alertId;
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid
          || providerCanReadAlert(alertId, request.auth.uid));
      allow update: if signedIn()
        && (
          (resource.data.customerId == request.auth.uid
            && (
              (resource.data.status == 'ACTIVE'
                && resource.data.expiresAt > request.time
                && request.resource.data.status == 'CANCELLED'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
              || (resource.data.status == 'ACCEPTED'
                && request.resource.data.status == 'CLOSED'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
            ))
          || (
            resource.data.status == 'ACTIVE'
            && resource.data.expiresAt > request.time
            && request.resource.data.status == 'ACCEPTED'
            && request.resource.data.acceptedProviderId == request.auth.uid
            && (resource.data.selectedProviderId == null
              || resource.data.selectedProviderId == request.auth.uid)
            && activeProviderNotification(alertId, request.auth.uid)
            && isProvider(request.auth.uid)
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.emergencyAvailable == true
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastLocationAt > request.time - duration.value(15, 'm')
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastLocationAt <= request.time
            && get(/databases/$(database)/documents/providerNotifications/$(alertId + "_" + request.auth.uid)).data.distanceKm <= 50
            && request.resource.data.acceptedAt == request.time
            && request.resource.data.acceptedProviderName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
            && request.resource.data.acceptedProviderPhone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'acceptedProviderId', 'acceptedProviderName', 'acceptedProviderPhone', 'acceptedAt'])
          )
        );
      allow delete: if false;

      match /responses/{providerId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/emergencyAlerts/$(alertId)).data.customerId == request.auth.uid
            || request.auth.uid == providerId);
        allow create: if isOwner(providerId)
          && isProvider(providerId)
          && get(/databases/$(database)/documents/emergencyAlerts/$(alertId)).data.status == 'ACTIVE'
          && request.resource.data.providerId == providerId;
        allow update, delete: if false;
      }
    }

    match /providerNotifications/{notificationId} {
      allow read: if signedIn() && resource.data.providerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.providerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead', 'isCleared', 'clearedAt', 'status'])
        && (
          (request.resource.data.status == resource.data.status
            && request.resource.data.isRead is bool)
          || (resource.data.status == 'ACTIVE'
            && request.resource.data.status == 'DECLINED'
            && request.resource.data.isRead == true
            && get(/databases/$(database)/documents/emergencyAlerts/$(resource.data.alertId)).data.status == 'ACTIVE'
            && get(/databases/$(database)/documents/emergencyAlerts/$(resource.data.alertId)).data.expiresAt > request.time)
        );
      allow create, delete: if false;
    }

    match /jobPosts/{jobId} {
      function customerOwnsJob() {
        return signedIn() && resource.data.customerId == request.auth.uid;
      }
      function validBidSelection() {
        let bidId = request.resource.data.selectedBidId;
        return resource.data.status == 'Open'
          && request.resource.data.status == 'Assigned'
          && bidId is string
          && exists(/databases/$(database)/documents/jobPosts/$(jobId)/bids/$(bidId))
          && get(/databases/$(database)/documents/jobPosts/$(jobId)/bids/$(bidId)).data.providerId
            == request.resource.data.assignedProviderId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'selectedBidId', 'assignedProviderId']);
      }
      function validCustomerReview() {
        return resource.data.status == 'Completed'
          && resource.data.customerConfirmed == false
          && request.resource.data.status == 'Completed'
          && request.resource.data.customerConfirmed == true
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['customerConfirmed', 'rating', 'reviewComment']);
      }
      function validCustomerSendBack() {
        return resource.data.status == 'Completed'
          && request.resource.data.status == 'In Progress'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'afterPhotoUrl'])
          && !request.resource.data.keys().hasAny(['afterPhotoUrl']);
      }
      function validProviderJobUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.assignedProviderId == request.auth.uid
          && (
            (resource.data.status == 'Assigned'
              && request.resource.data.status == 'In Progress'
              && changed.hasOnly(['status']))
            || (resource.data.status == 'In Progress'
              && request.resource.data.status == 'Completed'
              && changed.hasOnly(['status'])
              && request.resource.data.afterPhotoUrl is string
              && request.resource.data.afterPhotoUrl.size() > 0)
            || (resource.data.status in ['Assigned', 'In Progress']
              && changed.hasOnly(['providerLocation', 'beforePhotoUrl', 'afterPhotoUrl']))
          );
      }
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'Open';
      allow read: if signedIn()
        && (resource.data.status == 'Open'
          || resource.data.customerId == request.auth.uid
          || resource.data.assignedProviderId == request.auth.uid);
      allow update: if signedIn()
        && (
          (customerOwnsJob() && (validBidSelection() || validCustomerReview() || validCustomerSendBack()))
          || validProviderJobUpdate()
        );
      allow delete: if false;

      match /bids/{bidId} {
        function parentJob() {
          return get(/databases/$(database)/documents/jobPosts/$(jobId)).data;
        }
        allow read: if signedIn()
          && (parentJob().customerId == request.auth.uid
            || resource.data.providerId == request.auth.uid);
        allow create: if isProvider(request.auth.uid)
          && request.resource.data.providerId == request.auth.uid
          && parentJob().status == 'Open';
        allow update, delete: if false;
      }
    }
  }
}
