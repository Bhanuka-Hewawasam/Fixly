rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isProvider(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.roles is list
        && get(/databases/$(database)/documents/users/$(uid)).data.roles.hasAny(['provider']);
    }

    function validServiceProfile(data) {
      return data.serviceAddress is string
        && data.serviceAddress.size() <= 250
        && data.serviceCity is string
        && data.serviceCity.size() <= 120
        && data.serviceLatitude is number
        && data.serviceLatitude >= -90
        && data.serviceLatitude <= 90
        && data.serviceLongitude is number
        && data.serviceLongitude >= -180
        && data.serviceLongitude <= 180
        && data.serviceRadiusKm is int
        && data.serviceRadiusKm >= 1
        && data.serviceRadiusKm <= 100
        && data.serviceCategories is list
        && data.serviceCategories.size() > 0
        && data.availableForEmergency is bool;
    }

    function projectionMatchesUser(providerId) {
      let user = getAfter(/databases/$(database)/documents/users/$(providerId)).data;
      let ratings = getAfter(/databases/$(database)/documents/providerRatingAggregates/$(providerId)).data;
      return user.uid == providerId
        && user.roles.hasAny(['provider'])
        && validServiceProfile(user)
        && request.resource.data.providerId == providerId
        && request.resource.data.displayName == user.name
        && request.resource.data.profilePhotoUrl == user.profilePictureUrl
        && request.resource.data.serviceAddress == user.serviceAddress
        && request.resource.data.serviceCity == user.serviceCity
        && request.resource.data.serviceLatitude == user.serviceLatitude
        && request.resource.data.serviceLongitude == user.serviceLongitude
        && request.resource.data.serviceRadiusKm == user.serviceRadiusKm
        && request.resource.data.serviceCategories == user.serviceCategories
        && request.resource.data.availableForEmergency == user.availableForEmergency
        && request.resource.data.ratingCount == ratings.ratingCount
        && request.resource.data.rating == ratings.rating
        && request.resource.data.serviceRatings == ratings.serviceRatings
        && request.resource.data.isVerified == user.isVerified
        && request.resource.data.verificationStatus == (
          user.keys().hasAny(['verificationStatus'])
            ? user.verificationStatus
            : (user.isVerified == true ? 'VERIFIED' : 'PENDING')
        )
        && request.resource.data.suspended == (
          user.keys().hasAny(['suspended']) ? user.suspended : false
        )
        && request.resource.data.updatedAt == request.time;
    }

    function providerWithinServiceArea(providerId, alertLocation) {
      let area = get(/databases/$(database)/documents/emergencyServiceAreas/$(providerId)).data;
      let latitudeDistanceKm = (alertLocation.latitude - area.serviceLatitude) * 111.5;
      let longitudeDistanceKm = (alertLocation.longitude - area.serviceLongitude) * 111.5;
      return area.availableForEmergency == true
        && area.suspended == false
        && validServiceProfile(area)
        && latitudeDistanceKm * latitudeDistanceKm
          + longitudeDistanceKm * longitudeDistanceKm
          <= area.serviceRadiusKm * area.serviceRadiusKm;
    }

    function serviceCategoryMatches(providerId, category) {
      let categories = get(/databases/$(database)/documents/emergencyServiceAreas/$(providerId)).data.serviceCategories;
      return category in ['Any', 'Any Available Provider']
        || (category in ['Vehicle Mechanic', 'Mechanic']
          && categories.hasAny(['Vehicle Mechanic', 'Mechanic']))
        || (category in ['Electrician', 'Electrical']
          && categories.hasAny(['Electrician', 'Electrical']))
        || (category in ['Plumber', 'Plumbing']
          && categories.hasAny(['Plumber', 'Plumbing']))
        || (category in ['AC Technician', 'AC Repair']
          && categories.hasAny(['AC Technician', 'AC Repair']))
        || (category in ['Computer Technician', 'Computer Repair']
          && categories.hasAny(['Computer Technician', 'Computer Repair']))
        || (category == 'Other' && categories.hasAny(['Other']));
    }

    function validReviewForJob(jobId, providerId) {
      let jobPath = /databases/$(database)/documents/jobPosts/$(jobId);
      let reviewPath = /databases/$(database)/documents/serviceReviews/$(jobId);
      let job = get(jobPath).data;
      let completedJob = getAfter(jobPath).data;
      let review = getAfter(reviewPath).data;
      return signedIn()
        && exists(jobPath)
        && existsAfter(reviewPath)
        && job.customerId == request.auth.uid
        && job.assignedProviderId == providerId
        && job.customerId != providerId
        && job.status == 'Completed'
        && job.customerConfirmed == false
        && job.category is string
        && job.category.size() > 0
        && completedJob.status == 'Completed'
        && completedJob.customerConfirmed == true
        && review.keys().hasOnly([
          'bookingId', 'customerId', 'providerId', 'serviceCategory',
          'rating', 'comment', 'createdAt'
        ])
        && review.bookingId == jobId
        && review.customerId == request.auth.uid
        && review.providerId == providerId
        && review.serviceCategory == job.category
        && review.rating is int
        && review.rating >= 1
        && review.rating <= 5
        && review.comment is string
        && review.comment.size() <= 1000
        && review.createdAt == request.time;
    }

    function validFirstProviderRatingAggregate(providerId) {
      let jobId = request.resource.data.lastRatingJobId;
      let jobPath = /databases/$(database)/documents/jobPosts/$(jobId);
      let reviewPath = /databases/$(database)/documents/serviceReviews/$(jobId);
      let job = getAfter(jobPath).data;
      let review = getAfter(reviewPath).data;
      let categoryRating = request.resource.data.serviceRatings.get(job.category, {});
      return signedIn()
        && jobId is string
        && validReviewForJob(jobId, providerId)
        && request.resource.data.keys().hasOnly([
          'providerId', 'ratingSum', 'ratingCount', 'rating', 'serviceRatings',
          'availableForEmergency', 'lastRatingJobId', 'updatedAt'
        ])
        && request.resource.data.providerId == providerId
        && request.resource.data.ratingSum == review.rating
        && request.resource.data.ratingCount == 1
        && request.resource.data.rating == review.rating
        && request.resource.data.serviceRatings.keys().hasOnly([job.category])
        && categoryRating.averageRating == review.rating
        && categoryRating.reviewCount == 1
        && request.resource.data.availableForEmergency == false
        && request.resource.data.lastRatingJobId == jobId
        && request.resource.data.updatedAt == request.time;
    }

    function validProviderRatingAggregateUpdate(providerId) {
      let jobId = request.resource.data.lastRatingJobId;
      let jobPath = /databases/$(database)/documents/jobPosts/$(jobId);
      let reviewPath = /databases/$(database)/documents/serviceReviews/$(jobId);
      let job = getAfter(jobPath).data;
      let oldRatings = resource.data.get('serviceRatings', {});
      let oldCategoryRating = oldRatings.get(job.category, {
        'averageRating': 0,
        'reviewCount': 0
      });
      let newCategoryRating = request.resource.data.serviceRatings.get(job.category, {});
      return signedIn()
        && jobId is string
        && validReviewForJob(jobId, providerId)
        && resource.data.providerId == providerId
        && request.resource.data.providerId == providerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ratingSum', 'ratingCount', 'rating', 'serviceRatings',
          'lastRatingJobId', 'updatedAt'
        ])
        && request.resource.data.lastRatingJobId == jobId
        && request.resource.data.updatedAt == request.time
        && request.resource.data.availableForEmergency == resource.data.availableForEmergency
        && request.resource.data.ratingSum == resource.data.ratingSum + getAfter(reviewPath).data.rating
        && request.resource.data.ratingCount == resource.data.ratingCount + 1
        && request.resource.data.rating == request.resource.data.ratingSum
          / request.resource.data.ratingCount
        && request.resource.data.serviceRatings.diff(oldRatings).affectedKeys()
          .hasOnly([job.category])
        && newCategoryRating.reviewCount == oldCategoryRating.reviewCount + 1
        && newCategoryRating.averageRating == (
          oldCategoryRating.averageRating * oldCategoryRating.reviewCount
            + getAfter(reviewPath).data.rating
        ) / newCategoryRating.reviewCount;
    }

    function ownerCreatesProviderRatingAggregate(providerId) {
      let user = getAfter(/databases/$(database)/documents/users/$(providerId)).data;
      return isOwner(providerId)
        && request.resource.data.keys().hasOnly([
          'providerId', 'ratingSum', 'ratingCount', 'rating', 'serviceRatings',
          'availableForEmergency', 'lastRatingJobId', 'updatedAt'
        ])
        && request.resource.data.providerId == providerId
        && request.resource.data.ratingSum == user.ratingSum
        && request.resource.data.ratingCount == user.ratingCount
        && request.resource.data.rating == user.rating
        && request.resource.data.serviceRatings == user.get('serviceRatings', {})
        && request.resource.data.availableForEmergency == user.availableForEmergency
        && request.resource.data.lastRatingJobId == user.get('lastRatingJobId', null)
        && request.resource.data.updatedAt == request.time;
    }

    function ownerUpdatesProviderRatingAvailability(providerId) {
      let user = getAfter(/databases/$(database)/documents/users/$(providerId)).data;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isOwner(providerId)
        && resource.data.providerId == providerId
        && request.resource.data.providerId == providerId
        && changed.hasOnly(['availableForEmergency', 'updatedAt'])
        && request.resource.data.ratingSum == resource.data.ratingSum
        && request.resource.data.ratingCount == resource.data.ratingCount
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.serviceRatings == resource.data.serviceRatings
        && request.resource.data.lastRatingJobId == resource.data.lastRatingJobId
        && request.resource.data.availableForEmergency == user.availableForEmergency
        && request.resource.data.updatedAt == request.time;
    }

    function providerCanReadAlert(alertId, uid) {
      let alert = get(/databases/$(database)/documents/emergencyAlerts/$(alertId)).data;
      let notification = get(/databases/$(database)/documents/providerNotifications/$(alertId + "_" + uid)).data;
      return exists(/databases/$(database)/documents/providerNotifications/$(alertId + "_" + uid))
        && notification.providerId == uid
        && (
          (notification.status == 'ACTIVE'
            && alert.status == 'ACTIVE'
            && alert.expiresAt > request.time)
          || (notification.status == 'ACCEPTED'
            && alert.status == 'ACCEPTED'
            && alert.acceptedProviderId == uid)
        );
    }

    function activeProviderNotification(alertId, uid) {
      return exists(/databases/$(database)/documents/providerNotifications/$(alertId + "_" + uid))
        && get(/databases/$(database)/documents/providerNotifications/$(alertId + "_" + uid)).data.providerId == uid
        && get(/databases/$(database)/documents/providerNotifications/$(alertId + "_" + uid)).data.status == 'ACTIVE';
    }

    match /providerRatingAggregates/{providerId} {
      allow read: if signedIn();
      allow create: if ownerCreatesProviderRatingAggregate(providerId)
        || validFirstProviderRatingAggregate(providerId);
      allow update: if ownerUpdatesProviderRatingAvailability(providerId)
        || validProviderRatingAggregateUpdate(providerId);
      allow delete: if false;
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.isVerified == false
        && request.resource.data.ratingSum == 0
        && request.resource.data.ratingCount == 0
        && request.resource.data.rating == 0
        && (!request.resource.data.keys().hasAny(['serviceRatings'])
          || request.resource.data.serviceRatings == {})
        && request.resource.data.verificationStatus == 'PENDING'
        && request.resource.data.suspended == false
        && !request.resource.data.keys().hasAny([
          'emergencyServiceLocation', 'emergencyServiceLocationUpdatedAt'
        ])
        && (!request.resource.data.keys().hasAny(['emergencyAvailable'])
          || request.resource.data.emergencyAvailable == false)
        && (!request.resource.data.keys().hasAny(['lastLocation'])
          || request.resource.data.lastLocation == null)
        && (!request.resource.data.keys().hasAny(['lastLocationAt'])
          || request.resource.data.lastLocationAt == null)
        && !request.resource.data.keys().hasAny([
          'emergencySessionExpiresAt', 'emergencySessionId'
        ])
        && (
          (request.resource.data.availableForEmergency == false
            && request.resource.data.serviceLatitude == null
            && request.resource.data.serviceLongitude == null)
          || (isProvider(uid) && validServiceProfile(request.resource.data))
        );
      allow read: if isOwner(uid);
      allow update: if (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.roles == resource.data.roles
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['emergencyServiceLocation', 'emergencyServiceLocationUpdatedAt'])
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'ratingSum', 'ratingCount', 'rating', 'lastRatingJobId',
              'serviceRatings', 'isVerified'
            ])
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny([
              'emergencyAvailable', 'lastLocation', 'lastLocationAt',
              'emergencySessionExpiresAt', 'emergencySessionId',
              'isVerified', 'verificationStatus', 'suspended'
            ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'serviceAddress', 'serviceCity', 'serviceLatitude', 'serviceLongitude',
              'serviceRadiusKm', 'serviceCategories', 'availableForEmergency'
            ])
            || (isProvider(uid) && validServiceProfile(request.resource.data))
          )
        );
      allow delete: if false;
    }

    match /emergencyServiceAreas/{providerId} {
      allow read: if signedIn()
        && resource.data.availableForEmergency == true
        && resource.data.suspended == false;
      allow create, update: if isOwner(providerId)
        && projectionMatchesUser(providerId)
        && request.resource.data.keys().hasOnly([
          'providerId', 'displayName', 'profilePhotoUrl', 'serviceAddress', 'serviceCity',
          'serviceLatitude', 'serviceLongitude', 'serviceRadiusKm', 'serviceCategories',
          'availableForEmergency', 'rating', 'ratingCount', 'serviceRatings', 'isVerified',
          'verificationStatus', 'suspended', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /emergencyProviderContacts/{providerId} {
      function alertSelectsProvider(alertId) {
        let alertPath = /databases/$(database)/documents/emergencyAlerts/$(alertId);
        return alertId is string
          && exists(alertPath)
          && get(alertPath).data.customerId == request.auth.uid
          && get(alertPath).data.selectedProviderId == providerId
          && get(alertPath).data.status in ['ACTIVE', 'ACCEPTED']
          && (
            get(alertPath).data.status == 'ACCEPTED'
            || get(alertPath).data.expiresAt > request.time
          );
      }
      allow read: if signedIn()
        && exists(/databases/$(database)/documents/emergencyCustomerState/$(request.auth.uid))
        && alertSelectsProvider(
          get(/databases/$(database)/documents/emergencyCustomerState/$(request.auth.uid)).data.activeAlertId
        )
        && resource.data.keys().hasOnly(['providerId', 'phoneNumber'])
        && resource.data.providerId == providerId;
      allow create, update: if isOwner(providerId)
        && request.resource.data.keys().hasOnly(['providerId', 'phoneNumber'])
        && request.resource.data.providerId == providerId
        && request.resource.data.phoneNumber
          == getAfter(/databases/$(database)/documents/users/$(providerId)).data.phoneNumber;
      allow delete: if false;
    }

    match /emergencyCustomerState/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['activeAlertId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.activeAlertId)).data.customerId == uid
        && getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.activeAlertId)).data.status == 'ACTIVE';
      allow delete: if false;
    }

    match /emergencyAlerts/{alertId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.alertId == alertId
        && request.resource.data.keys().hasAll([
          'customerName', 'customerPhone', 'category', 'note', 'location',
          'status', 'createdAt', 'expiresAt', 'selectedProviderId',
          'acceptedProviderId', 'acceptedProviderName', 'acceptedProviderPhone', 'acceptedAt',
          'jobPostId'
        ])
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'm')
        && request.resource.data.location is latlng
        && request.resource.data.customerName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.customerPhone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber
        && request.resource.data.acceptedProviderId == null
        && request.resource.data.acceptedProviderName == null
        && request.resource.data.acceptedProviderPhone == null
        && request.resource.data.acceptedAt == null
        && request.resource.data.jobPostId == null
        && getAfter(/databases/$(database)/documents/emergencyCustomerState/$(request.auth.uid)).data.activeAlertId == alertId
        && (
          request.resource.data.selectedProviderId == null
          || (
            request.resource.data.selectedProviderId is string
            && request.resource.data.selectedProviderId != request.auth.uid
            && exists(/databases/$(database)/documents/emergencyServiceAreas/$(request.resource.data.selectedProviderId))
            && providerWithinServiceArea(
              request.resource.data.selectedProviderId,
              request.resource.data.location
            )
          )
        );
      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid
          || providerCanReadAlert(alertId, request.auth.uid));
      allow update: if signedIn()
        && (
          (resource.data.customerId == request.auth.uid
            && (
              (resource.data.status == 'ACTIVE'
                && resource.data.expiresAt > request.time
                && request.resource.data.status == 'CANCELLED'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
              || (resource.data.status == 'ACCEPTED'
                && request.resource.data.status == 'CLOSED'
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
            ))
          || (
            resource.data.status == 'ACTIVE'
            && resource.data.expiresAt > request.time
            && request.resource.data.status == 'ACCEPTED'
            && request.resource.data.acceptedProviderId == request.auth.uid
            && (resource.data.selectedProviderId == null
              || resource.data.selectedProviderId == request.auth.uid)
            && activeProviderNotification(alertId, request.auth.uid)
            && isProvider(request.auth.uid)
            && exists(/databases/$(database)/documents/emergencyServiceAreas/$(request.auth.uid))
            && providerWithinServiceArea(request.auth.uid, resource.data.location)
            && request.resource.data.acceptedAt == request.time
            && request.resource.data.acceptedProviderName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
            && request.resource.data.acceptedProviderPhone == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phoneNumber
            && request.resource.data.jobPostId == 'emergency_' + alertId
            && getAfter(/databases/$(database)/documents/jobPosts/$(request.resource.data.jobPostId)).data.emergencyAlertId == alertId
            && getAfter(/databases/$(database)/documents/jobPosts/$(request.resource.data.jobPostId)).data.assignedProviderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'acceptedProviderId', 'acceptedProviderName', 'acceptedProviderPhone', 'acceptedAt', 'jobPostId'])
          )
        );
      allow delete: if false;

      match /responses/{providerId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/emergencyAlerts/$(alertId)).data.customerId == request.auth.uid
            || request.auth.uid == providerId);
        allow create: if isOwner(providerId)
          && isProvider(providerId)
          && get(/databases/$(database)/documents/emergencyAlerts/$(alertId)).data.status == 'ACTIVE'
          && request.resource.data.providerId == providerId;
        allow update, delete: if false;
      }
    }

    match /providerNotifications/{notificationId} {
      allow read: if signedIn() && resource.data.providerId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'notificationId', 'providerId', 'alertId', 'type', 'title', 'body',
          'serviceType', 'distanceKm', 'isRead', 'isCleared', 'status', 'createdAt',
          'expiresAt'
        ])
        && request.resource.data.notificationId == notificationId
        && request.resource.data.providerId is string
        && request.resource.data.alertId is string
        && notificationId == request.resource.data.alertId + '_' + request.resource.data.providerId
        && request.resource.data.type == 'EMERGENCY_ALERT'
        && request.resource.data.isRead == false
        && request.resource.data.isCleared == false
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.alertId)).data.customerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.alertId)).data.status == 'ACTIVE'
        && getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.alertId)).data.expiresAt > request.time
        && request.resource.data.expiresAt
          == getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.alertId)).data.expiresAt
        && exists(/databases/$(database)/documents/emergencyServiceAreas/$(request.resource.data.providerId))
        && (
          getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.alertId)).data.selectedProviderId
            == request.resource.data.providerId
          || getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.alertId)).data.selectedProviderId == null
        )
        && serviceCategoryMatches(
          request.resource.data.providerId,
          getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.alertId)).data.category
        )
        && providerWithinServiceArea(
          request.resource.data.providerId,
          getAfter(/databases/$(database)/documents/emergencyAlerts/$(request.resource.data.alertId)).data.location
        );
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead', 'isCleared', 'clearedAt', 'status'])
        && (
          (resource.data.providerId == request.auth.uid
            && (
              (request.resource.data.status == resource.data.status
                && request.resource.data.isRead is bool)
              || (resource.data.status == 'ACTIVE'
                && request.resource.data.status == 'DECLINED'
                && request.resource.data.isRead == true
                && get(/databases/$(database)/documents/emergencyAlerts/$(resource.data.alertId)).data.status == 'ACTIVE'
                && get(/databases/$(database)/documents/emergencyAlerts/$(resource.data.alertId)).data.expiresAt > request.time)
              || (resource.data.status == 'ACTIVE'
                && request.resource.data.status == 'ACCEPTED'
                && request.resource.data.isRead == true
                && getAfter(/databases/$(database)/documents/emergencyAlerts/$(resource.data.alertId)).data.status == 'ACCEPTED'
                && getAfter(/databases/$(database)/documents/emergencyAlerts/$(resource.data.alertId)).data.acceptedProviderId == request.auth.uid)
            ))
          || (resource.data.status in ['ACTIVE', 'ACCEPTED']
            && request.resource.data.status in ['CANCELLED', 'CLOSED']
            && !(resource.data.status == 'ACCEPTED'
              && request.resource.data.status == 'CANCELLED')
            && get(/databases/$(database)/documents/emergencyAlerts/$(resource.data.alertId)).data.customerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/emergencyAlerts/$(resource.data.alertId)).data.status == request.resource.data.status)
        );
      allow delete: if false;
    }

    match /bookingLocks/{lockId} {
      allow read: if signedIn()
        && (resource == null || resource.data.customerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'customerId', 'providerId', 'serviceCategory', 'jobId'
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.providerId is string
        && request.resource.data.serviceCategory is string
        && lockId == request.auth.uid + '__' + request.resource.data.providerId
          + '__' + request.resource.data.serviceCategory
        && getAfter(/databases/$(database)/documents/jobPosts/$(request.resource.data.jobId)).data.customerId
          == request.auth.uid
        && getAfter(/databases/$(database)/documents/jobPosts/$(request.resource.data.jobId)).data.status
          == 'Assigned'
        && getAfter(/databases/$(database)/documents/jobPosts/$(request.resource.data.jobId)).data.assignedProviderId
          == request.resource.data.providerId
        && getAfter(/databases/$(database)/documents/jobPosts/$(request.resource.data.jobId)).data.category
          == request.resource.data.serviceCategory
        && getAfter(/databases/$(database)/documents/jobPosts/$(request.resource.data.jobId)).data.bookingLockId
          == lockId;
      allow delete: if signedIn()
        && resource.data.customerId == request.auth.uid
        && get(/databases/$(database)/documents/jobPosts/$(resource.data.jobId)).data.customerId
          == request.auth.uid
        && get(/databases/$(database)/documents/jobPosts/$(resource.data.jobId)).data.customerConfirmed == false
        && getAfter(/databases/$(database)/documents/jobPosts/$(resource.data.jobId)).data.customerConfirmed == true
        && getAfter(/databases/$(database)/documents/jobPosts/$(resource.data.jobId)).data.status == 'Completed';
      allow update: if false;
    }

    match /serviceReviews/{bookingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'bookingId', 'customerId', 'providerId', 'serviceCategory',
          'rating', 'comment', 'createdAt'
        ])
        && request.resource.data.bookingId == bookingId
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.providerId is string
        && validReviewForJob(bookingId, request.resource.data.providerId);
      allow update, delete: if false;
    }

    match /jobPosts/{jobId} {
      function customerOwnsJob() {
        return signedIn() && resource.data.customerId == request.auth.uid;
      }
      function validBidSelection() {
        let bidId = request.resource.data.selectedBidId;
        let providerId = request.resource.data.assignedProviderId;
        let category = resource.data.category;
        let lockId = request.resource.data.bookingLockId;
        let lockPath = /databases/$(database)/documents/bookingLocks/$(lockId);
        return resource.data.status == 'Open'
          && request.resource.data.status == 'Assigned'
          && bidId is string
          && providerId is string
          && category is string
          && lockId == request.auth.uid + '__' + providerId + '__' + category
          && existsAfter(lockPath)
          && getAfter(lockPath).data.customerId == request.auth.uid
          && getAfter(lockPath).data.providerId == providerId
          && getAfter(lockPath).data.serviceCategory == category
          && getAfter(lockPath).data.jobId == jobId
          && exists(/databases/$(database)/documents/jobPosts/$(jobId)/bids/$(bidId))
          && get(/databases/$(database)/documents/jobPosts/$(jobId)/bids/$(bidId)).data.providerId
            == providerId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'status', 'selectedBidId', 'assignedProviderId',
              'assignedProviderName', 'bookingLockId'
            ]);
      }
      function validCustomerReview() {
        let reviewPath = /databases/$(database)/documents/serviceReviews/$(jobId);
        let review = getAfter(reviewPath).data;
        return resource.data.status == 'Completed'
          && resource.data.customerConfirmed == false
          && request.resource.data.status == 'Completed'
          && request.resource.data.customerConfirmed == true
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.rating == review.rating
          && request.resource.data.reviewComment == review.comment
          && validReviewForJob(jobId, resource.data.assignedProviderId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['customerConfirmed', 'rating', 'reviewComment']);
      }
      function validCustomerSendBack() {
        return resource.data.status == 'Completed'
          && resource.data.customerConfirmed == false
          && request.resource.data.status == 'In Progress'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'afterPhotoUrl'])
          && !request.resource.data.keys().hasAny(['afterPhotoUrl']);
      }
      function validProviderJobUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return resource.data.assignedProviderId == request.auth.uid
          && (
            (resource.data.status == 'Assigned'
              && request.resource.data.status == 'In Progress'
              && changed.hasOnly(['status']))
            || (resource.data.status == 'In Progress'
              && request.resource.data.status == 'Completed'
              && changed.hasOnly(['status'])
              && request.resource.data.afterPhotoUrl is string
              && request.resource.data.afterPhotoUrl.size() > 0)
            || (resource.data.status in ['Assigned', 'In Progress']
              && changed.hasOnly(['providerLocation', 'beforePhotoUrl', 'afterPhotoUrl']))
          );
      }
      function validEmergencyAcceptanceJob() {
        let alertId = request.resource.data.emergencyAlertId;
        let alert = getAfter(/databases/$(database)/documents/emergencyAlerts/$(alertId));
        return signedIn()
          && isProvider(request.auth.uid)
          && alertId is string
          && jobId == 'emergency_' + alertId
          && request.resource.data.keys().hasOnly([
            'jobId', 'customerId', 'customerName', 'category', 'description',
            'preferredDate', 'preferredTime', 'isEmergency', 'location', 'address',
            'status', 'assignedProviderId', 'assignedProviderName', 'emergencyAlertId',
            'customerConfirmed', 'createdAt'
          ])
          && request.resource.data.jobId == jobId
          && request.resource.data.customerId == alert.data.customerId
          && request.resource.data.customerName == alert.data.customerName
          && request.resource.data.category == alert.data.category
          && request.resource.data.description == alert.data.note
          && request.resource.data.preferredDate == ''
          && request.resource.data.preferredTime == ''
          && request.resource.data.isEmergency == true
          && request.resource.data.location == alert.data.location
          && request.resource.data.address == 'Emergency request location'
          && request.resource.data.status == 'Assigned'
          && request.resource.data.assignedProviderId == request.auth.uid
          && request.resource.data.assignedProviderName == alert.data.acceptedProviderName
          && request.resource.data.customerConfirmed == false
          && request.resource.data.createdAt == request.time
          && alert.data.status == 'ACCEPTED'
          && alert.data.acceptedProviderId == request.auth.uid
          && alert.data.jobPostId == jobId;
      }
      allow create: if (signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'Open')
        || validEmergencyAcceptanceJob();
      allow read: if signedIn()
        && (resource.data.status == 'Open'
          || resource.data.customerId == request.auth.uid
          || resource.data.assignedProviderId == request.auth.uid);
      allow update: if signedIn()
        && (
          (customerOwnsJob() && (validBidSelection() || validCustomerReview() || validCustomerSendBack()))
          || validProviderJobUpdate()
        );
      allow delete: if false;

      match /bids/{bidId} {
        function parentJob() {
          return get(/databases/$(database)/documents/jobPosts/$(jobId)).data;
        }
        allow read: if signedIn()
          && (parentJob().customerId == request.auth.uid
            || resource.data.providerId == request.auth.uid);
        allow create: if isProvider(request.auth.uid)
          && request.resource.data.providerId == request.auth.uid
          && parentJob().status == 'Open';
        allow update, delete: if false;
      }
    }
  }
}
